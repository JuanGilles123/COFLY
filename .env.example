# Configuración de base de datos para COFLY (Neon PostgreSQL)

# Connection String de tu base de datos de Neon (se usa en el servidor de Netlify y funciones locales)
# Ejemplo: postgresql://username:password@ep-cool-breeze-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=tu_cadena_de_conexion_de_neon

# Variable opcional para desarrollo local. Ponla en true si deseas conectar localmente a Neon
# Si está en false o no se define, se usará LocalStorage para desarrollo local
VITE_CONNECT_TO_DB=false

