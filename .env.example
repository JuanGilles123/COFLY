# Configuración de Supabase para Producción / Futura Conexión
# Copia este archivo a `.env` y rellena las credenciales con tu proyecto de Supabase.

# URL de tu proyecto de Supabase (ej. https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=tu_supabase_project_url

# Clave pública Anon de tu proyecto de Supabase
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key
